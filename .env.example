# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: inserta pedidos validados en submitOrder. Nunca usar el
# prefijo NEXT_PUBLIC_ ni importarla desde componentes cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Secreto para hashear IP/email en rate limiting. Si falta, se usa
# SUPABASE_SERVICE_ROLE_KEY. Solo servidor; nunca NEXT_PUBLIC_.
RATE_LIMIT_SECRET=

# WhatsApp del negocio, solo dígitos, con código de país (Chile: 56)
NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678

# Opcional en desarrollo; necesario en Vercel para proteger el cron de pedidos.
# Solo servidor: no usar el prefijo NEXT_PUBLIC_.
CRON_SECRET=

# Google Maps Places: clave para el autocompletado en el navegador.
# Restringir por HTTP referrer (localhost y dominio web) y por API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Clave distinta y privada para validar direcciones en el servidor.
# Restringir a Places API (New); nunca agregar NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=
